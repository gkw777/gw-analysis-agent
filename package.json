{
  "name": "analysis-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env VITE_DEPLOY_ENV=local vite",
    "build:dev": "cross-env VITE_DEPLOY_ENV=dev vite build --mode development",
    "build:stg": "cross-env VITE_DEPLOY_ENV=stg vite build --mode staging",
    "build:prod": "cross-env VITE_DEPLOY_ENV=prod vite build --mode production",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^5.16.7",
    "@mui/material": "^5.16.7",
    "@mui/x-data-grid": "^7.22.2",
    "axios": "^1.7.4",
    "classnames": "^2.5.1",
    "jotai": "^2.9.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^4.12.3",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^8.56.0",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "cross-env": "^10.1.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "msw": "^2.15.0",
    "prettier": "^3.3.0",
    "sass": "^1.77.8",
    "terser": "^5.50.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.2",
    "vite-plugin-svgr": "^5.2.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
